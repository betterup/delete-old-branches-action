#!/bin/bash

set -eo pipefail

[[ -n ${INPUT_REPO_TOKEN} ]] || { echo "Please set the REPO_TOKEN input"; exit 1; }
[[ -n ${INPUT_DATE} ]] || { echo "Please specify a suitable date input for branch filtering"; exit 1; }

REPO="${GITHUB_REPOSITORY}"
DATE=${INPUT_DATE}
DRY_RUN=${INPUT_DRY_RUN:-true}
DELETE_TAGS=${INPUT_DELETE_TAGS:-false}
MINIMUM_TAGS=${INPUT_MINIMUM_TAGS:-0}
DEFAULT_BRANCHES=${INPUT_DEFAULT_BRANCHES:-main,master}
EXCLUDE_BRANCH_REGEX=${INPUT_EXTRA_PROTECTED_BRANCH_REGEX:-^$}
EXCLUDE_TAG_REGEX=${INPUT_EXTRA_PROTECTED_TAG_REGEX:-^$}
EXCLUDE_OPEN_PR_BRANCHES=${INPUT_EXCLUDE_OPEN_PR_BRANCHES:-true}
BRANCH_LIST=${INPUT_BRANCH_LIST:-}

# used for GitHub CLI authentication
export GITHUB_TOKEN=${INPUT_REPO_TOKEN}

echo "was_dry_run=${DRY_RUN}" >> "$GITHUB_OUTPUT"

deleted_branches=()
error_branches=()

# Function to output final results
output_results() {
    echo ""
    echo "====== FINAL RESULTS ======"
    echo "Successfully deleted branches (${#deleted_branches[@]}): ${deleted_branches[*]}"
    echo "Branches with errors (${#error_branches[@]}): ${error_branches[*]}"
    echo "deleted_branches=${deleted_branches[*]}" >> "$GITHUB_OUTPUT"
    echo "error_branches=${error_branches[*]}" >> "$GITHUB_OUTPUT"
    echo "deleted_count=${#deleted_branches[@]}" >> "$GITHUB_OUTPUT"
    echo "error_count=${#error_branches[@]}" >> "$GITHUB_OUTPUT"
}

# Set up signal handlers to output results on early exit
trap 'echo "Script interrupted. Outputting results collected so far..."; output_results; exit 130' INT TERM

default_branch_protected() {
    local br=${1}

    local default_branches
    default_branches=$(echo "${DEFAULT_BRANCHES}" | tr "," "\n")

    for default_branch in $default_branches; do
        if [[ "${br}" == "${default_branch}" ]]; then
            return 0
        fi
    done

    return 1
}

branch_protected() {
    local br=${1}

    protected=$(gh api "repos/${REPO}/branches/${br}" --jq '.protected')

    # If we got null then something else happened (like no access error etc) so
    # we can't determine the status for the branch
    case ${protected} in
        null) echo "Unable to determine status for branch: ${br}"; return 0 ;;
        true) return 0 ;;
        *) return 1 ;;
    esac
}

extra_branch_or_tag_protected() {
    local br=${1} ref="${2}"

    if [[ "${ref}" == "branch" ]]; then
        echo "${br}" | grep -qE "${EXCLUDE_BRANCH_REGEX}"
    elif [[ "${ref}" == "tag" ]]; then
        echo "${br}" | grep -qE "${EXCLUDE_TAG_REGEX}"
    fi

    return $?
}

is_pr_open_on_branch() {
    if [[ "${EXCLUDE_OPEN_PR_BRANCHES}" == false ]]; then
        return 1
    fi

    local br=${1}
    # Check against cached open PR branches instead of making API calls
    echo "${OPEN_PR_BRANCHES}" | grep -qx "${br}"
    return $?
}

delete_branch_or_tag() {
    local br=${1} ref="${2}" sha="${3}"

    echo "Deleting: ${br}"
    echo "To recreate run: git branch '${br}' '${sha}'"
    if [[ "${DRY_RUN}" == false ]]; then
        status=$(gh api --method DELETE "repos/${REPO}/git/refs/${ref}/${br}" &> debug.log && echo ok || echo failed)

        case ${status} in
            ok)
                deleted_branches+=("${br}")
                ;;
            *)
                echo "Deletion of branch ${br} failed with http_status=${status}"
                echo "===== Dumping log ====="
                [[ -f debug.log ]] && cat debug.log
                error_branches+=("${br}:delete_failed")
                ;;
        esac
    else
        echo "dry-run mode. Nothing changed!"
        deleted_branches+=("${br}")
    fi
}

main() {
    # No git fetch needed - we'll use GitHub API instead
    local sha

    # Determine which branches to process
    local branches_to_process
    if [[ -n "${BRANCH_LIST}" ]]; then
        echo "Processing specific branch list (batch mode)..."
        branches_to_process="${BRANCH_LIST}"
    else
        echo "Processing all branches (legacy mode)..."
        # Get all branches from ls-remote (no fetch needed, queries remote directly)
        branches_to_process=$(git ls-remote -q --heads --refs | sed "s@^.*heads/@@")
    fi

    # Fetch all open PR branches once
    echo "Fetching open PR branches..."
    if [[ "${EXCLUDE_OPEN_PR_BRANCHES}" == true ]]; then
        OPEN_PR_BRANCHES=$(gh api "repos/${REPO}/pulls" --jq '.[].head.ref' --paginate)
        local pr_count=$(echo "${OPEN_PR_BRANCHES}" | grep -c '^' || echo 0)
        echo "Found ${pr_count} branches with open PRs"
    else
        OPEN_PR_BRANCHES=""
    fi

    # Convert DATE input to epoch once before the loop
    echo "Converting cutoff date: ${DATE}"
    cutoff_epoch=$(date -d "${DATE}" +%s 2>/dev/null || date -j -f "%Y-%m-%d" "${DATE}" +%s 2>/dev/null)
    if [[ -z "${cutoff_epoch}" ]]; then
        echo "Error: Failed to parse date '${DATE}'. Please use a format like '60 days ago' or 'YYYY-MM-DD'"
        exit 1
    fi
    echo "Cutoff epoch: ${cutoff_epoch} ($(date -d "@${cutoff_epoch}" 2>/dev/null || date -r "${cutoff_epoch}" 2>/dev/null))"

    echo "Checking branches..."
    for br in ${branches_to_process}; do

        # Use GitHub API to get branch commit info (no git fetch needed)
        echo "Checking branch: ${br}"
        if ! branch_info=$(gh api "repos/${REPO}/branches/${br}" 2>/dev/null); then
            echo "Error: Branch ${br} does not exist in remote repository or cannot be accessed. Skipping..."
            error_branches+=("${br}:missing_or_inaccessible")
            continue
        fi

        # Extract commit date and SHA from API response
        commit_date=$(echo "${branch_info}" | jq -r '.commit.commit.committer.date')
        sha=$(echo "${branch_info}" | jq -r '.commit.sha')

        if [[ -z "${sha}" || "${sha}" == "null" ]]; then
            echo "Error: Failed to get SHA for branch: ${br}. Skipping..."
            error_branches+=("${br}:no_sha")
            continue
        fi

        # Convert commit date to epoch for comparison
        commit_epoch=$(date -d "${commit_date}" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "${commit_date}" +%s 2>/dev/null)

        if [[ -z "${commit_epoch}" ]]; then
            echo "Error: Failed to parse commit date '${commit_date}' for branch ${br}. Skipping..."
            error_branches+=("${br}:date_parse_error")
            continue
        fi

        # Check if branch is stale (commit is older than cutoff date)
        if [[ ${commit_epoch} -lt ${cutoff_epoch} ]]; then
            default_branch_protected "${br}" && echo "branch: ${br} is a default branch. Won't delete it" && continue
            branch_protected "${br}" && echo "branch: ${br} is likely protected. Won't delete it" && continue
            extra_branch_or_tag_protected "${br}" "branch" && echo "branch: ${br} is explicitly protected and won't be deleted" && continue
            is_pr_open_on_branch "${br}" && echo "branch: ${br} has an open pull request and won't be deleted" && continue
            delete_branch_or_tag "${br}" "heads" "${sha}"
        else
            echo "branch: ${br} has recent commits (last commit: ${commit_date}), skipping"
        fi
    done
    if [[ "${DELETE_TAGS}" == true ]]; then
        echo "Checking tags..."
        local tag_counter=1

        # Get all tags from ls-remote and sort in reverse version order
        for tag in $(git ls-remote -q --tags --refs | sed "s@^.*tags/@@" | sort -Vr); do
            echo "Checking tag: ${tag}"

            # Use GitHub API to get tag commit info
            if ! tag_info=$(gh api "repos/${REPO}/git/refs/tags/${tag}" 2>/dev/null); then
                echo "Warning: Could not fetch info for tag ${tag}, skipping..."
                continue
            fi

            # Get the commit SHA from the tag
            tag_sha=$(echo "${tag_info}" | jq -r '.object.sha')

            if [[ -z "${tag_sha}" || "${tag_sha}" == "null" ]]; then
                echo "Warning: Failed to get SHA for tag ${tag}, skipping..."
                continue
            fi

            # Get commit info to check date
            if ! commit_info=$(gh api "repos/${REPO}/git/commits/${tag_sha}" 2>/dev/null); then
                echo "Warning: Could not fetch commit info for tag ${tag}, skipping..."
                continue
            fi

            tag_date=$(echo "${commit_info}" | jq -r '.committer.date')
            tag_epoch=$(date -d "${tag_date}" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "${tag_date}" +%s 2>/dev/null)

            if [[ -z "${tag_epoch}" ]]; then
                echo "Warning: Failed to parse date '${tag_date}' for tag ${tag}, skipping..."
                continue
            fi

            # Check if tag is stale
            if [[ ${tag_epoch} -lt ${cutoff_epoch} ]]; then
                if [[ ${tag_counter} -gt ${MINIMUM_TAGS} ]]; then
                    extra_branch_or_tag_protected "${tag}" "tag" && echo "tag: ${tag} is explicitly protected and won't be deleted" && continue
                    delete_branch_or_tag "${tag}" "tags" "${tag_sha}"
                else
                    echo "Not deleting tag ${tag} due to minimum tag requirement(min: ${MINIMUM_TAGS})"
                    ((tag_counter+=1))
                fi
            else
                echo "tag: ${tag} has recent commits (date: ${tag_date}), skipping"
            fi
        done
    fi

    # Output final results
    output_results
}

main "$@"
